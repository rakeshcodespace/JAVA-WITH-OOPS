// CODES OF LECTURE 6

public class Lecture6Abstraction {
    public static void main(String[] args) {
        System.out.println("=== Lecture 6: Abstraction and Interfaces in Java ===\n");

        // Abstract class Example
        Vehicle[] vehicles = {
            new Car("Red"),
            new Bike("Blue")
        };

        System.out.println("--- Abstract class polymorphism ---");
        for (Vehicle vehicle : vehicles) {
            vehicle.start();
            vehicle.stop();
            System.out.println("Vehicle color: " + vehicle.color);
            System.out.println();
        }

        // Interface Example
        Payment[] payments = {
            new UPI(),
            new CreditCard(),
            new Cash()
        };

        System.out.println("--- Interface polymorphism ---");
        for (Payment payment : payments) {
            payment.pay();
            payment.printReceipt();
            System.out.println();
        }

        // instanceof demo
        Vehicle v = new Car("Black");
        if (v instanceof Car) {
            Car c = (Car) v;
            System.out.println("Vehicle is a Car with color: " + c.color);
        }
    }
}

abstract class Vehicle {
    String color;

    Vehicle(String color) {
        this.color = color;
    }

    abstract void start();

    void stop() {
        System.out.println("Vehicle stopped.");
    }
}

class Car extends Vehicle {
    Car(String color) {
        super(color);
    }

    @Override
    void start() {
        System.out.println("Car started. Engine is running.");
    }
}

class Bike extends Vehicle {
    Bike(String color) {
        super(color);
    }

    @Override
    void start() {
        System.out.println("Bike started. Kick start is used.");
    }
}

interface Payment {
    void pay();

    default void printReceipt() {
        System.out.println("Receipt generated successfully.");
    }
}

class UPI implements Payment {
    @Override
    public void pay() {
        System.out.println("Paying using UPI");
    }
}

class CreditCard implements Payment {
    @Override
    public void pay() {
        System.out.println("Paying using Credit Card");
    }
}

class Cash implements Payment {
    @Override
    public void pay() {
        System.out.println("Paying using Cash");
    }
}
