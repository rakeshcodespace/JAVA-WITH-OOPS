import java.util.ArrayList;
import java.util.List;

public class Lecture7Autoboxing {
    public static void main(String[] args) {
        System.out.println("=== Lecture 7: Classes, Objects, and Autoboxing ===\n");

        CountRecord first = new CountRecord("First", 10);
        CountRecord second = new CountRecord("Second", 25);

        first.add(5);
        System.out.println(first.getLabel() + " count: " + first.getCount());
        System.out.println(second.getLabel() + " count: " + second.getCount());

        int primitiveScore = 42;
        Integer wrappedScore = primitiveScore;
        int unwrappedScore = wrappedScore;
        System.out.println("\nPrimitive score: " + primitiveScore);
        System.out.println("Wrapped score: " + wrappedScore);
        System.out.println("Unwrapped score: " + unwrappedScore);

        List<Integer> scores = new ArrayList<>();
        scores.add(80);
        scores.add(95);
        int total = 0;
        for (Integer score : scores) {
            total += score;
        }
        System.out.println("\nScores: " + scores);
        System.out.println("Total: " + total);
    }
}

final class CountRecord {
    private final String label;
    private int count;

    CountRecord(String label, int count) {
        this.label = label;
        this.count = count;
    }

    String getLabel() {
        return label;
    }

    int getCount() {
        return count;
    }

    void add(int amount) {
        count += amount;
    }
}
