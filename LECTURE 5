// CODE OF LECTURE 5

public class Lecture5Polymorphism {
    public static void main(String[] args) {
        System.out.println("=== Lecture 5: Polymorphism in Java ===\n");

        // Compile-time polymorphism (method overloading)
        Calculator calculator = new Calculator();
        System.out.println("Add ints: " + calculator.add(10, 20));
        System.out.println("Add three ints: " + calculator.add(10, 20, 30));
        System.out.println("Add doubles: " + calculator.add(12.5, 7.5));

        System.out.println();

        // Runtime polymorphism (method overriding)
        Shape[] shapes = {
            new Circle("Red", 4),
            new Rectangle("Blue", 5, 6),
            new Triangle("Green", 3, 4)
        };

        for (Shape shape : shapes) {
            shape.draw();
            System.out.println("Area: " + shape.area());
            System.out.println();
        }

        // Upcasting + instanceof
        Shape shape = new Circle("Black", 7);
        if (shape instanceof Circle) {
            Circle circle = (Circle) shape;
            System.out.println("Shape is a Circle with radius " + circle.radius);
        }
    }
}

class Calculator {
    int add(int a, int b) {
        return a + b;
    }

    int add(int a, int b, int c) {
        return a + b + c;
    }

    double add(double a, double b) {
        return a + b;
    }
}

abstract class Shape {
    String color;

    Shape(String color) {
        this.color = color;
    }

    abstract void draw();
    abstract double area();
}

class Circle extends Shape {
    double radius;

    Circle(String color, double radius) {
        super(color);
        this.radius = radius;
    }

    @Override
    void draw() {
        System.out.println("Drawing a circle with color " + color);
    }

    @Override
    double area() {
        return Math.PI * radius * radius;
    }
}

class Rectangle extends Shape {
    double length;
    double breadth;

    Rectangle(String color, double length, double breadth) {
        super(color);
        this.length = length;
        this.breadth = breadth;
    }

    @Override
    void draw() {
        System.out.println("Drawing a rectangle with color " + color);
    }

    @Override
    double area() {
        return length * breadth;
    }
}

class Triangle extends Shape {
    double base;
    double height;

    Triangle(String color, double base, double height) {
        super(color);
        this.base = base;
        this.height = height;
    }

    @Override
    void draw() {
        System.out.println("Drawing a triangle with color " + color);
    }

    @Override
    double area() {
        return 0.5 * base * height;
    }
}
