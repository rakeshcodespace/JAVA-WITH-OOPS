// CODE OF LECTURE 4

public class Lecture4Inheritance {
    public static void main(String[] args) {
        System.out.println("=== Lecture 4: Inheritance in Java ===\n");

        Employee emp = new Employee("Asha", 28, 50000);
        emp.display();
        emp.greet();

        System.out.println();

        Manager manager = new Manager("Ravi", 35, 90000, "Engineering");
        manager.display();
        manager.greet();
        manager.manageTeam();

        System.out.println();

        Developer developer = new Developer("Mina", 26, 75000, "Java");
        developer.display();
        developer.greet();
        developer.writeCode();

        System.out.println();

        // Upcasting: parent reference can point to child object
        Person person = new Manager("Nisha", 32, 85000, "HR");
        person.greet();

        // Runtime polymorphism via method overriding
        Person[] people = {new Employee("Sam", 30, 60000), new Manager("Karan", 40, 110000, "Sales")};

        for (Person p : people) {
            p.display();
        }
    }
}

class Person {
    protected String name;
    protected int age;

    Person(String name, int age) {
        this.name = name;
        this.age = age;
    }

    void greet() {
        System.out.println("Hello, I am " + name + " and I am " + age + " years old.");
    }

    void display() {
        System.out.println("Person: " + name + ", age: " + age);
    }
}

class Employee extends Person {
    protected double salary;

    Employee(String name, int age, double salary) {
        super(name, age);
        this.salary = salary;
    }

    @Override
    void display() {
        System.out.println("Employee: " + name + ", age: " + age + ", salary: " + salary);
    }
}

class Manager extends Employee {
    private String department;

    Manager(String name, int age, double salary, String department) {
        super(name, age, salary);
        this.department = department;
    }

    @Override
    void display() {
        System.out.println("Manager: " + name + ", age: " + age + ", salary: " + salary + ", department: " + department);
    }

    void manageTeam() {
        System.out.println(name + " is managing the " + department + " team.");
    }
}

class Developer extends Employee {
    private String techStack;

    Developer(String name, int age, double salary, String techStack) {
        super(name, age, salary);
        this.techStack = techStack;
    }

    @Override
    void display() {
        System.out.println("Developer: " + name + ", age: " + age + ", salary: " + salary + ", stack: " + techStack);
    }

    void writeCode() {
        System.out.println(name + " is writing code in " + techStack + ".");
    }
}
